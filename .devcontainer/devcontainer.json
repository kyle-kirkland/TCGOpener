{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "noVncVersion": "1.2.0",
      "webPort": "6080"
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
      "6080": {
        "label": "desktop"
      }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "runArgs": ["--shm-size=1g"],
  "runArgs": ["--init"],
  "postCreateCommand": "xrandr --output VNC-0 --mode 1920x1200",
  "runArgs": [
    "--cap-add=SYS_ADMIN",
    "--cap-add=SYS_PTRACE"
  ]
}
